LAB_BACKEND=lima
# auto tests nested KVM; M1/M2 use QEMU software emulation for the tenant.
LAB_ACCEL=auto
# Memory is allocated to the Linux VM, in MiB.
LAB_MEMORY=8192
LAB_CPUS=6
LAB_DISK=80G
# Legacy Docker/QEMU host SSH port; Lima manages its own SSH connection.
LAB_SSH_PORT=2222
LAB_API_PORT=9200
LAB_WORKER_PORT=9202
LAB_BAO_PORT=8200
