FROM ghcr.io/openbao/openbao:2.7.2 AS bao
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl jq && rm -rf /var/lib/apt/lists/*
COPY --from=bao /usr/bin/bao /usr/local/bin/bao
COPY guest/bao-unseal.sh guest/bao-configure.sh /usr/local/lib/latch/
COPY containers/openbao.sh /usr/local/bin/start-openbao
ENTRYPOINT ["/bin/bash", "/usr/local/bin/start-openbao"]
