FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY latch_api/requirements.txt /app/latch_api/requirements.txt
RUN pip install --no-cache-dir -r /app/latch_api/requirements.txt \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin latch
COPY latch_api /app/latch_api
COPY latch_common /app/latch_common
USER 10001:10001
EXPOSE 8300
CMD ["uvicorn", "latch_api.app:app", "--host", "0.0.0.0", "--port", "8300", "--no-access-log"]
