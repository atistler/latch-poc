FROM python:3.12-slim
WORKDIR /app
COPY latch_api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --no-create-home latch
COPY latch_api /app/latch_api
COPY latch_common /app/latch_common
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "-m", "latch_api.server_app"]
